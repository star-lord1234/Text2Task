              "scripted",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "recipient_ids": {
            "items": {
              "type": "string"
            },
            "title": "Recipient Ids",
            "type": "array"
          },
          "sender_id": {
            "title": "Sender Id",
            "type": "string"
          },
