        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "changes": {
            "additionalProperties": true,
            "title": "Changes",
            "type": "object"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "actor_id",
          "expected_version",
          "changes"
        ],
        "title": "TaskPatch",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
