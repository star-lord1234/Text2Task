        "required": [
          "actor_id"
        ],
        "title": "AcceptBody",
        "type": "object"
      },
      "DismissBody": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "actor_id"
        ],
        "title": "DismissBody",
        "type": "object"
      },
      "EdgeAction": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "actor_id"
        ],
        "title": "EdgeAction",
        "type": "object"
      },
      "EdgeCreate": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "dependent_task_id": {
            "title": "Dependent Task Id",
            "type": "string"
          },
          "evidence": {
            "default": "",
            "title": "Evidence",
            "type": "string"
          },
          "prerequisite_task_id": {
            "title": "Prerequisite Task Id",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "prerequisite_task_id",
          "dependent_task_id"
        ],
        "title": "EdgeCreate",
        "type": "object"
      },
