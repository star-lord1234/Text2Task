{
  "version": "mailex-map-v1.2.0",
  "description": "Deterministic mapping from MailEx human event annotations to Text2Task TASK/PERSON/TEMPORAL spans.",
  "task": {
    "event_prefixes": [
      "Request_Action"
    ],
    "slot": "Action Description",
    "commitment_event_prefixes": [
      "Deliver_Action",
      "Amend_Action"
    ],
    "commitment_pattern": "^(?:(?:will|'ll|ll|shall)\\s+(?:be\\s+\\w+ing\\b|(?!be\\b|have\\b|not\\b))|(?:am|are|is)\\s+going\\s+(?:to\\s+)?(?!be\\b)|going\\s+to\\s+(?!be\\b)|gonna\\s+)",
    "notes": "Core TASK = Action Description inside Request_Action* events. Commitments = Deliver_Action*/Amend_Action* descriptions starting with will/'ll/shall/going to (not 'will be <state>'), included by default per guidelines v2 (future commitment = TASK); build with --requests-only to exclude. Request_Data (asking for data/forwarding items) is NOT mapped: MailEx labels only the data object, not the request phrase. Known source gap: some clear requests have no MailEx annotation at all."
  },
  "temporal": {
    "slot_regex": "(Date|Time)$",
    "max_tokens": 8,
    "clause_start_regex": "^(?:once|upon|when|whenever|if|as soon as|by the time|while|since|after|before|prior to|until|till)\\b",
    "clause_keep_regex": "(?:\\d|\\b(?:today|tomorrow|tonight|yesterday|day|days|week|weeks|month|months|year|years|hour|hours|minute|minutes|morning|afternoon|evening|night|noon|midnight|monday|tuesday|wednesday|thursday|friday|saturday|sunday|january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec|am|pm|a\\.m|p\\.m|cob|eod|close of business|weekend|quarter|asap|now)\\b)",
    "notes": "MailEx Date/Time slots sometimes capture event clauses (e.g. 'Upon her approval'). Spans that begin with a subordinating word and contain no calendar/clock word are dropped."
  },
  "person": {
    "slot_regex": "Members?$",
    "max_tokens": 3,
    "token_regex": "^[A-Z][A-Za-z'\\-\\.]*$",
