  {
   "name": "G02_cycle_is_held_with_its_path_and_changes_nothing",
   "description": "a cycle-forming edge is refused, kept as held, and does not block",
   "tasks": [
    {
     "owner": "a",
     "status": "open",
     "thread": "th1"
    },
    {
     "owner": "b",
     "status": "open",
     "thread": "th1"
    },
    {
     "owner": "c",
     "status": "open",
     "thread": "th1"
    }
   ],
   "steps": [
    {
     "add": [
      "T-1",
      "T-2"
     ],
     "expect": {
      "status": "accepted"
     }
    },
    {
     "add": [
      "T-2",
      "T-3"
     ],
     "expect": {
      "status": "accepted"
     }
    },
    {
     "add": [
      "T-3",
      "T-1"
     ],
     "expect": {
      "status": "rejected",
      "code": "CYCLE",
      "cycle_path": [
       "T-3",
       "T-1",
       "T-2",
       "T-3"
      ]
     }
    },
    {
     "check": {
      "acyclic": true,
      "kinds": {
       "accepted": 2,
       "held": 1,
       "proposed": 0
      },
      "states": {
       "T-1": "ready",
       "T-2": "blocked",
       "T-3": "blocked"
      },
      "edge_reason_prefix": {
       "T-3>T-1": "CYCLE:"
      },
      "order": [
       "T-1",
       "T-2",
       "T-3"
      ]
     }
    },
    {
     "remove": [
      "T-2",
      "T-3"
     ],
     "expect": {
      "applied": true
     }
    },
    {
     "reconsider": [
      "T-3",
      "T-1"
     ],
     "expect": {
      "status": "accepted",
      "code": "OK"
     }
    },
    {
     "check": {
      "acyclic": true,
      "kinds": {
       "accepted": 2,
       "held": 1
      },
      "order": [
       "T-3",
       "T-1",
       "T-2"
      ],
      "states": {
       "T-3": "ready",
       "T-1": "blocked",
       "T-2": "blocked"
      }
     }
    }
   ]
  },
