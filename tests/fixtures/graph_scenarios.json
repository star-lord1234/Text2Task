  {
   "name": "G01_three_person_chain_unblocks_in_order",
   "description": "completing a prerequisite unblocks exactly the next task",
   "tasks": [
    {
     "owner": "bianca",
     "status": "open",
     "thread": "th1"
    },
    {
     "owner": "dev",
     "status": "open",
     "thread": "th1"
    },
    {
     "owner": "riya",
     "status": "open",
     "thread": "th1"
    }
   ],
   "steps": [
    {
     "add": [
      "T-1",
      "T-2"
     ],
     "expect": {
      "status": "accepted",
      "code": "OK"
     }
    },
    {
     "add": [
      "T-2",
      "T-3"
     ],
     "expect": {
      "status": "accepted",
      "code": "OK"
     }
    },
    {
     "check": {
      "states": {
       "T-1": "ready",
       "T-2": "blocked",
       "T-3": "blocked"
      },
      "order": [
       "T-1",
       "T-2",
       "T-3"
      ],
      "layers": {
       "T-1": 0,
       "T-2": 1,
       "T-3": 2
      },
      "root_blockers": {
       "T-3": [
        "T-1"
       ],
       "T-2": [
        "T-1"
       ]
      },
      "blocked_by": {
       "T-3": [
        "T-2"
       ]
      },
      "longest_chain": [
       "T-1",
       "T-2",
       "T-3"
      ]
     }
    },
    {
     "impact": [
      "T-1",
      "completed"
     ],
     "expect_diff": {
      "became_ready": [
       "T-2"
      ],
      "became_done": [
       "T-1"
      ],
      "became_blocked": []
     }
    },
    {
     "check": {
      "states": {
       "T-1": "ready",
       "T-2": "blocked"
      }
     }
    },
    {
     "status": [
      "T-1",
      "completed"
     ],
     "expect_diff": {
      "became_ready": [
       "T-2"
      ],
      "became_done": [
       "T-1"
      ]
     }
    },
    {
     "check": {
      "states": {
       "T-1": "done",
       "T-2": "ready",
       "T-3": "blocked"
      },
      "root_blockers": {
       "T-3": [
        "T-2"
       ]
      }
     }
    },
    {
     "status": [
      "T-2",
      "in_progress"
     ],
     "expect_diff": {
      "became_ready": []
     }
    },
    {
     "check": {
      "states": {
       "T-2": "ready",
       "T-3": "blocked"
      }
     }
    },
    {
     "status": [
      "T-2",
